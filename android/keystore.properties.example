# Local release signing for Distrust.
#
# 1. Copy this file to android/keystore.properties (it is git-ignored).
# 2. Point storeFile at your own keystore and fill in the credentials.
#
# Never commit android/keystore.properties or the keystore itself.
# GitHub Actions uses repository secrets instead (see .github/workflows/android.yml):
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
#
# Base64-encoding the keystore for the ANDROID_KEYSTORE_BASE64 secret:
#   Linux:   base64 -w0 release.jks
#   macOS:   base64 -i release.jks

storeFile=/absolute/path/to/release.jks
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
